NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Demo/test: allow repeated free previews (skip 1× email/IP/device cap).
# Defaults ON when unset; set DEMO_MODE=0 before real launch.
DEMO_MODE=1

# HMAC for order-bound signed upload/preview URLs (required in production)
ORDER_SIGNING_SECRET=change-me-to-a-long-random-string

# Optional for D1 — without these, in-memory DB + mock storage/preview are used
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

FAL_KEY=
REPLICATE_API_TOKEN=
IMAGE_PROVIDER=fal

# D2 payment (mock-pay until set)
CREEM_API_KEY=
CREEM_PRODUCT_ID=
CREEM_WEBHOOK_SECRET=
MOCK_PAYMENTS=1

LLM_API_KEY=
LLM_MODEL=
RESEND_API_KEY=
CRON_SECRET=change-me-cron-secret
FACE_SIM_THRESHOLD=0.55
